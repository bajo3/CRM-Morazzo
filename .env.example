# Arquitectura del proyecto:
# frontend (Vite/React) -> API propia (Express) -> Supabase Postgres por DATABASE_URL
# Este proyecto NO usa supabase-js en frontend.
# No hace falta VITE_SUPABASE_URL ni VITE_SUPABASE_ANON_KEY para que la app funcione.

# API
# Supabase Dashboard > Project Settings > Database > Connection string > URI
# Usar la conexion directa, no pooler.
# Ejemplo: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
PORT=4000

# WEB
# URL base de la API propia.
VITE_API_URL=http://localhost:4000/api
